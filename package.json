{
  "name": "chess-studio",
  "productName": "Chess Studio",
  "version": "0.1.0",
  "description": "Professional chess game review, engine analysis and position study",
  "main": "out/main/index.js",
  "author": "Chess Studio",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "npm run ocr:assets && electron-vite dev",
    "build": "npm run ocr:assets && electron-vite build",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "chess.js": "^1.4.0",
    "lucide-react": "^1.70.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stockfish": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^6.1.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.0"
  }
}
